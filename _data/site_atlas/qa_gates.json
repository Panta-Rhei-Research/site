{
  "description": "Pack F operational QA gates. Atlas source checks are strict immediately; built-site gates become strict in site CI after the Atlas payload is projected into the public website.\n",
  "gates": [
    {
      "command": "python3 site-atlas/scripts/site_atlas_validate.py",
      "gate_key": "schema_validation",
      "severity": "required",
      "title": "Schema validation",
      "type": "mechanical"
    },
    {
      "command": "python3 site-atlas/scripts/site_atlas_check_routes.py --built-root _site --mode fail",
      "gate_key": "route_existence",
      "severity": "required",
      "title": "Manifest route existence",
      "type": "mechanical"
    },
    {
      "command": "python3 site-atlas/scripts/site_atlas_check_collection_counts.py --site-root . --built-root _site",
      "gate_key": "collection_counts",
      "severity": "required",
      "title": "Collection count parity",
      "type": "mechanical"
    },
    {
      "command": "python3 site-atlas/scripts/site_atlas_check_built_meta.py --built-root _site --mode fail",
      "gate_key": "built_meta_tags",
      "severity": "required",
      "title": "Built Atlas metadata",
      "type": "mechanical"
    },
    {
      "command": "python3 site-atlas/scripts/site_atlas_check_visible_terms.py --built-root _site --mode fail",
      "gate_key": "built_visible_terminology",
      "severity": "required",
      "title": "Visible deprecated terminology",
      "type": "mechanical"
    },
    {
      "command": "python3 site-atlas/scripts/site_atlas_check_terms.py --mode report",
      "gate_key": "source_terminology_report",
      "severity": "report",
      "title": "Source deprecated terminology report",
      "type": "mechanical"
    },
    {
      "command": "python3 site-atlas/scripts/site_atlas_check_duplicates.py --built-root _site --mode fail",
      "gate_key": "duplicate_surfaces",
      "severity": "required",
      "title": "Duplicate surface check",
      "type": "mechanical"
    },
    {
      "command": "python3 site-atlas/scripts/site_atlas_inventory.py --source .",
      "gate_key": "source_inventory",
      "severity": "report",
      "title": "Source inventory",
      "type": "mechanical"
    },
    {
      "command": "python3 site-atlas/scripts/site_atlas_narrative_audit.py",
      "gate_key": "narrative_audit",
      "severity": "report",
      "title": "Narrative audit",
      "type": "editorial"
    },
    {
      "command": "python3 site-atlas/scripts/site_atlas_generate_remediation_queue.py",
      "gate_key": "remediation_queue",
      "severity": "report",
      "title": "Launch remediation queue",
      "type": "editorial"
    },
    {
      "command": "python3 site-atlas/scripts/site_atlas_check_release_state.py --target public-launch-v4",
      "gate_key": "release_state",
      "severity": "required",
      "title": "Release state and reopen ledger",
      "type": "mechanical"
    },
    {
      "command": "python3 site-atlas/scripts/site_atlas_check_release_metric_parity.py --corpus-root <clean-corpus> --site-root <clean-site> --taulib-root <clean-taulib>",
      "gate_key": "release_metric_parity",
      "severity": "required",
      "title": "Corpus release metric parity",
      "type": "mechanical"
    }
  ],
  "manifest_type": "site-atlas-qa-gates",
  "release_gates": [
    {
      "blocks_greenlight": true,
      "gate_key": "G0",
      "required_output": "site-atlas/release/2026-05-v4-public-launch/g0-build.md",
      "title": "Repository / build gate"
    },
    {
      "blocks_greenlight": true,
      "gate_key": "G1",
      "required_output": "site-atlas/release/2026-05-v4-public-launch/g1-atlas-manifest.md",
      "title": "Site Atlas manifest gate"
    },
    {
      "blocks_greenlight": true,
      "gate_key": "G2",
      "required_output": "site-atlas/release/2026-05-v4-public-launch/g2-terminology.md",
      "title": "Terminology / v4 semantics gate"
    },
    {
      "blocks_greenlight": true,
      "gate_key": "G3",
      "required_output": "site-atlas/release/2026-05-v4-public-launch/g3-routes-navigation.md",
      "title": "Route / navigation / redirect gate"
    },
    {
      "blocks_greenlight": true,
      "gate_key": "G4",
      "required_output": "site-atlas/release/2026-05-v4-public-launch/g4-pages.md",
      "title": "Page-level editorial gate"
    },
    {
      "blocks_greenlight": true,
      "gate_key": "G5",
      "required_output": "site-atlas/release/2026-05-v4-public-launch/g5-collections.md",
      "title": "Collection-level gate"
    },
    {
      "blocks_greenlight": true,
      "gate_key": "G6",
      "required_output": "site-atlas/release/2026-05-v4-public-launch/g6-assets-pdfs.md",
      "title": "Asset / PDF gate"
    },
    {
      "blocks_greenlight": true,
      "gate_key": "G7",
      "required_output": "site-atlas/release/2026-05-v4-public-launch/g7-lanes.md",
      "title": "Lane-level gate"
    },
    {
      "blocks_greenlight": true,
      "gate_key": "G8",
      "required_output": "site-atlas/release/2026-05-v4-public-launch/g8-live-smoke.md",
      "title": "Live-site smoke gate"
    },
    {
      "blocks_greenlight": true,
      "gate_key": "G9",
      "required_output": "site-atlas/release/2026-05-v4-public-launch/public-launch-greenlight.md",
      "title": "Public outreach greenlight gate"
    }
  ],
  "schema_version": "0.2.0",
  "status": "active",
  "version": "2026-05-v4-public-launch-gates"
}
